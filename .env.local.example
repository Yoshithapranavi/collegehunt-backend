# CollegeHunt Backend - Example Environment Variables
# Copy this file to .env and fill in your actual values

# Database Connection
# For local development: postgresql://postgres:password@localhost:5432/collegehunt_db
# For Railway: Will be auto-populated as DATABASE_URL
DATABASE_URL="postgresql://postgres:password@localhost:5432/collegehunt_db"

# Server Configuration
PORT=3000
NODE_ENV="development"

# Admin API Key (use for /api/admin/* endpoints)
# Generate a strong key: openssl rand -hex 32
ADMIN_API_KEY="dev-admin-key-change-in-production"

# Optional: Redis for caching (bonus feature)
# REDIS_URL="redis://localhost:6379"

# Optional: Logging
# LOG_LEVEL="info"
